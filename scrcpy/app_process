#!/bin/sh
set -eu

export SCRCPY_COMPAT_DISPLAY="${SCRCPY_COMPAT_DISPLAY:-:99}"

for server in \
    /usr/local/lib/scrcpy-compat/fake_server.py \
    /usr/lib/scrcpy-compat/fake_server.py \
    /usr/lib/*/scrcpy-compat/fake_server.py \
    "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/../lib/scrcpy-compat/fake_server.py"; do
    if [ -f "$server" ]; then
        exec /usr/bin/python3 "$server" "$@"
    fi
done

printf '%s\n' 'scrcpy compatibility server is not installed' >&2
exit 127
